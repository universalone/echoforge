{
  "name": "echoforge",
  "productName": "EchoForge",
  "version": "0.2.8",
  "description": "EchoForge - next-gen console emulation launcher",
  "author": "EchoForge contributors",
  "main": "app/main.js",
  "updateRepo": "universalone/echoforge",
  "scripts": {
    "start": "electron .",
    "test": "node test/guide_test.js && node test/app_updates_test.js && node test/pads_test.js && node test/quit_test.js && node test/skins_test.js && node test/wheels_test.js && node test/wheelgames_test.js && node test/synopsis_test.js && node test/inbox_test.js && node test/inbox_archive_test.js && node test/appx_test.js && node test/emu_updates_test.js && node test/rpcs3_install_test.js && node test/pcsx2_setup_test.js",
    "dist": "electron-builder --win nsis",
    "postinstall": "node node_modules/electron/install.js"
  },
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.echoforge.launcher",
    "productName": "EchoForge",
    "copyright": "EchoForge contributors Â· GPL-3.0-or-later",
    "files": ["app/**/*", "package.json"],
    "asarUnpack": ["app/padwatch.ps1", "app/sdlprobe.ps1"],
    "directories": { "output": "dist" },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "app/assets/icon.ico" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EchoForge",
      "installerIcon": "app/assets/icon.ico",
      "uninstallerIcon": "app/assets/icon.ico",
      "artifactName": "EchoForge-Setup-${version}.${ext}"
    }
  }
}
